{
  "name": "cluely-lite-electron",
  "version": "2.0.0",
  "description": "Electron UI for Cluely-Lite (local-first)",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "dist": "electron-builder --mac",
    "build:icon": "cd scripts && bash gen-icon.sh"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "ai.cluely.lite",
    "productName": "Cluely-Lite",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "entitlements": "entitlements.mac.plist",
      "gatekeeperAssess": false,
      "sign": false,
      "identity": null
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "extraResources": []
  }
}
